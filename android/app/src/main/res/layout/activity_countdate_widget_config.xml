<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F0FF"
    tools:context=".CountdateWidgetConfig">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:id="@+id/textView3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configure Widget"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#21005D"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/textView4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose an event, then customise appearance below."
            android:textSize="13sp"
            android:textColor="#49454F"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginBottom="8dp" />

        <!-- ── Step 1: Pick event ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="① Select Event"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#6750A4"
            android:layout_marginBottom="6dp" />

        <!-- Dynamic Event Items Container (naturally expands & scrolls seamlessly with the page) -->
        <LinearLayout
            android:id="@+id/events_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- ── Step 2: Display Unit ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="② Display Unit"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#6750A4"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose how you want the count displayed on the widget."
            android:textSize="11sp"
            android:textColor="#757575"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/unit_radiogroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/radio_unit_ymd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Years, Months &amp; Days (e.g. 2y 3m 12d)"
                android:textSize="13sp"
                android:textColor="#21005D"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radio_unit_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Days only (e.g. 842d)"
                android:textSize="13sp"
                android:textColor="#21005D" />

            <RadioButton
                android:id="@+id/radio_unit_months"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Months &amp; Days (e.g. 27m 12d)"
                android:textSize="13sp"
                android:textColor="#21005D" />

            <RadioButton
                android:id="@+id/radio_unit_years"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Years &amp; Days (e.g. 2y 112d)"
                android:textSize="13sp"
                android:textColor="#21005D" />

            <RadioButton
                android:id="@+id/radio_unit_weeks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Weeks &amp; Days (e.g. 120w 2d)"
                android:textSize="13sp"
                android:textColor="#21005D" />

            <RadioButton
                android:id="@+id/radio_unit_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Days &amp; Time (e.g. 12d 5h 30m)"
                android:textSize="13sp"
                android:textColor="#21005D" />

        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginBottom="12dp" />

        <!-- ── Step 3: Theme colour ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="③ Widget Colour"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#6750A4"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use the widget’s default, follow the in-app theme, or pick any Daymark palette. Opacity below still applies."
            android:textSize="11sp"
            android:textColor="#757575"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/theme_selected_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Widget default"
            android:textSize="13sp"
            android:textColor="#21005D"
            android:layout_marginBottom="6dp" />

        <GridLayout
            android:id="@+id/theme_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="6"
            android:alignmentMode="alignMargins"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginBottom="12dp" />

        <!-- ── Step 4: Opacity ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="④ Background Opacity"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#6750A4"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/opacity_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textSize="13sp"
            android:textColor="#49454F"
            android:gravity="end"
            android:layout_marginBottom="4dp" />

        <SeekBar
            android:id="@+id/opacity_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="100"
            android:progressTint="#6750A4"
            android:thumbTint="#6750A4"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Controls the transparency of the coloured overlay. Lower values reveal more of the wallpaper or home screen."
            android:textSize="11sp"
            android:textColor="#757575"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginBottom="12dp" />

        <!-- ── Step 5: Wallpaper image ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⑤ Widget Wallpaper (optional)"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#6750A4"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The image scales to fill the widget at any size. Lower opacity in step ③ so the photo shows through the colour overlay."
            android:textSize="11sp"
            android:textColor="#757575"
            android:layout_marginBottom="8dp" />

        <!-- Thumbnail preview -->
        <ImageView
            android:id="@+id/wallpaper_preview"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:scaleType="centerCrop"
            android:background="#E8DEF8"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            android:contentDescription="Wallpaper preview" />

        <TextView
            android:id="@+id/wallpaper_none_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No wallpaper selected"
            android:textSize="13sp"
            android:textColor="#757575"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <!-- Wallpaper buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btn_pick_wallpaper"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📷 Choose Image"
                android:backgroundTint="#6750A4"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_remove_wallpaper"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✕ Remove"
                android:backgroundTint="#B3261E"
                android:textColor="#FFFFFF"
                android:layout_marginStart="6dp"
                android:visibility="gone" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- ── Confirm button ── -->
        <Button
            android:id="@+id/btn_add_widget"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Add Widget"
            android:textSize="16sp"
            android:backgroundTint="#6750A4"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

</ScrollView>
